# Locates BWAPI 4.4.0 and builds BWAPILIB (the static helper library every AI
# module links against) from its sources.
#
# BWAPI_DIR must contain include/BWAPI.h and BWAPILIB/. Both layouts work:
#   - the BWAPI installer's folder (default %USERPROFILE%\BWAPI)
#   - a git checkout of https://github.com/bwapi/bwapi at tag v4.4.0, sub folder "bwapi"
#
# Building BWAPILIB ourselves (instead of linking a prebuilt BWAPI.lib) keeps the
# compiler and runtime identical to the bot DLL, which is what the official
# ExampleProjects.sln does as well.

if(NOT BWAPI_DIR)
  message(FATAL_ERROR "BWAPI_DIR is not set")
endif()

get_filename_component(BWAPI_DIR "${BWAPI_DIR}" ABSOLUTE)

if(NOT EXISTS "${BWAPI_DIR}/include/BWAPI.h")
  message(FATAL_ERROR "BWAPI_DIR='${BWAPI_DIR}' does not contain include/BWAPI.h")
endif()

file(GLOB BWAPILIB_SOURCES
  "${BWAPI_DIR}/BWAPILIB/Source/*.cpp"
  "${BWAPI_DIR}/BWAPILIB/*.cpp")
if(NOT BWAPILIB_SOURCES)
  message(FATAL_ERROR "No BWAPILIB sources under '${BWAPI_DIR}/BWAPILIB'. "
                      "Install BWAPI with the 'Library\\Headers' component or use the git checkout.")
endif()

# Check the BWAPI version this project was written against.
file(STRINGS "${BWAPI_DIR}/include/starcraftver.h" BWAPI_VER_LINE REGEX "#define BWAPI_VER ")
string(REGEX MATCH "\"([0-9.]+)\"" _ "${BWAPI_VER_LINE}")
set(BWAPI_VERSION "${CMAKE_MATCH_1}")
if(NOT BWAPI_VERSION STREQUAL "4.4.0")
  message(WARNING "Found BWAPI ${BWAPI_VERSION}; BeginnerBot was written and tested against BWAPI 4.4.0")
else()
  message(STATUS "Found BWAPI ${BWAPI_VERSION} at ${BWAPI_DIR}")
endif()

# svnrev.h is generated by BWAPI's own build (revisionUpdate.vbs). Installed copies
# ship it; a plain git checkout does not. Only BWAPI_getRevision() uses it.
set(BWAPI_GENERATED_INCLUDE "")
if(NOT EXISTS "${BWAPI_DIR}/include/svnrev.h")
  set(BWAPI_GENERATED_INCLUDE "${CMAKE_BINARY_DIR}/bwapi_generated")
  file(WRITE "${BWAPI_GENERATED_INCLUDE}/svnrev.h"
    "#pragma once\n// Generated by BeginnerBot's CMake: BWAPI's svnrev.h was not found.\nstatic const int SVN_REV = 0;\n#include \"starcraftver.h\"\n")
endif()

add_library(bwapilib STATIC ${BWAPILIB_SOURCES})
target_include_directories(bwapilib SYSTEM PUBLIC "${BWAPI_DIR}/include")
if(BWAPI_GENERATED_INCLUDE)
  target_include_directories(bwapilib PRIVATE "${BWAPI_GENERATED_INCLUDE}")
endif()
target_compile_definitions(bwapilib PUBLIC NOMINMAX)
set_target_properties(bwapilib PROPERTIES POSITION_INDEPENDENT_CODE ON)
if(MSVC)
  target_compile_options(bwapilib PRIVATE /W0)
else()
  target_compile_options(bwapilib PRIVATE -w)
endif()
